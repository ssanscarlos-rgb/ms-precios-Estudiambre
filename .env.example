# Copiar a .env (NO se commitea). En Azure van como App settings.
PORT=8080

# Secret en GitHub / App setting. Cadena de MongoDB Atlas (o de Cosmos DB for MongoDB).
# Si queda vacío se usa un almacén en memoria (solo para desarrollo local).
MONGO_URI=

# Variables (nombre de la base y de la colección)
MONGO_DB=estudiambre_precios
COLLECTION_PRECIOS=precios

# Thumbprint SHA-1 del certificado cliente de APIM, sin los ":".
# Si queda vacío y NODE_ENV != production, el filtro de certificado se desactiva (solo local).
CLIENT_CERT_THUMBPRINT=
